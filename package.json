{
  "name": "direcao-profissional",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Direção Profissional — um GPS para quem quer ganhar o próprio dinheiro começando do zero.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:unico": "vite build --mode unico",
