# Mentor Norte (lado servidor). Sem esta chave o app funciona, e o Norte avisa que está desligado.
ANTHROPIC_API_KEY=
# Opcional: trocar o modelo do Norte (padrão: claude-opus-5-5)
# NORTE_MODELO=claude-opus-5-5

# Opcional: exigir login para falar com o Norte (recomendado em produção)
# NORTE_EXIGE_LOGIN=1
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Contas e cópia do progresso na nuvem (lado navegador). Sem estas duas, o app guarda tudo só no aparelho.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
